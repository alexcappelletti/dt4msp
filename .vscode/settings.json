{
	"typescript.tsdk": "node_modules/typescript/lib",
	"typescript.preferences.importModuleSpecifier": "shortest",
	"editor.detectIndentation": true,
	"editor.insertSpaces": false,
	"editor.tabSize": 4,
	"[vue]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"editor.formatOnSave": true,
	"editor.lineNumbers": "on",
	"editor.lineHeight": 18,
	"editor.tokenColorCustomizations": {
		"textMateRules": [
			{
				"scope": "meta.line-number",
				"settings": {
					"fontSize": "10px"
				}
			}
		]
	},
	"workbench.colorCustomizations": {
			"activityBar.background": "#524f4e",
			"activityBar.dropBorder": "#77036d",
			"activityBar.foreground": "#a254b6",
			"activityBar.inactiveForeground": "#bca7c4",
			"activityBar.border": "#8f918a",
			"activityBarBadge.background": "#c50ca08e",
			"activityBarBadge.foreground": "#dd6464",
			"sideBar.background": "#444242",
			"statusBar.background": "#eeeeee",
			"editor.foreground": "#9c8888",
			"editorCursor.foreground": "#f3ebeb",
			"editorLineNumber.activeForeground": "#e5eebb",
			"editorLineNumber.foreground": "#7f6f6f",
			"editorHoverWidget.background": "#4c4e4b",
			"editorHoverWidget.foreground":"#b19358",         // sfondo popup
			"editorHoverWidget.border": "#999299",             // bordo popup
			"editorError.foreground": "#da132d",               // colore testo errore
			//editorError.background": "#fcfcfc",               // colore sfondo errore	
			"editorWhitespace.foreground": "#9e9b94",


			"editorWarning.foreground": "#db9406",             // colore testo warning
			"editorWarning.background": "#eedcdc",             // colore sfondo warning
			"editorMarkerNavigationError.background": "#e2d8d8",
			"editorSuggestWidget.foreground":"#d4be98",
			"editorSuggestWidget.background":"#3c3836",
			"editorMarkerNavigationError.headerBackground": "#806f6f",
			"editorMarkerNavigationInfo.background": "#d0e6f6",
			"editorMarkerNavigationWarning.background": "#fce8d4",
			"editorHint.border": "#e2e055",
			"editorHint.foreground": "#005577",
			"editorInfo.foreground": "#c47d13",
			"problemsInfoIcon.foreground": "#e92831",
		"list.activeSelectionForeground": "#e66108",
		"list.focusBackground": "#db9595"
	},
	"editor.fontSize": 14,
	"files.associations": {
		"*.css": "tailwindcss"
	},
	"editor.quickSuggestions": {
		"strings": "on"
	},
	"tailwindCSS.classAttributes": [
		"class",
		"ui"
	],
	"tailwindCSS.experimental.classRegex": [
		[
			"ui:\\s*{([^)]*)\\s*}",
			"(?:'|\"|`)([^']*)(?:'|\"|`)"
		]
	]
}