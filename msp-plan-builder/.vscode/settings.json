{
	"editor.defaultFormatter": "esbenp.prettier-vscode",
	"editor.detectIndentation": false,
	"editor.insertSpaces": false,
	"editor.renderWhitespace": "selection",
	"editor.tabSize": 4,
	"[vue]": {
		"editor.defaultFormatter": "Vue.volar"
	},
	// Configurazione specifica per i file Vue (Official/Volar)
	"vue.format.enable": true,
	"prettier.vueIndentScriptAndStyle": true,
	"editor.codeActionsOnSave": {
		// Ordina i blocchi <script>, <template>, <style> al salvataggio
		"source.organizeImports": "explicit",
		"source.sortMembers.all": "explicit"
	},
	// Imposta la lingua predefinita per i blocchi <script> in .vue su TypeScript
	"vue.script.defaultLang": "ts",
	// Assicurati che l'HTML in Vue sia formattato con Prettier
	// Assicurati che i file TS/JS usino Prettier come formatter
	"[typescript]": {
		"editor.defaultFormatter": "vscode.typescript-language-features"
	},
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode"
	},
	"editor.formatOnSave": true,
	"editor.lineNumbers": "on",
	"editor.fontSize": 13,
	"editor.fontFamily": "Fira code",
	"editor.tokenColorCustomizations": {},
